#!/bin/sh

set -eu

fail() {
  printf '%s\n' "$1" >&2
  exit 127
}

run_mcp() {
  executable=$1
  shift

  if [ ! -x "$executable" ]; then
    fail "Flow MCP is not executable at: $executable"
  fi

  exec "$executable" "$@"
}

if [ "$(uname -s)" != "Darwin" ]; then
  fail "The Flow desktop integration currently requires macOS."
fi

if [ -n "${FLOW_MCP_PATH:-}" ]; then
  run_mcp "$FLOW_MCP_PATH" "$@"
fi

for flow_app in \
  "/Applications/Flow.app" \
  "$HOME/Applications/Flow.app"
do
  flow_mcp="$flow_app/Contents/Resources/bin/flow-mcp"
  if [ -x "$flow_mcp" ]; then
    run_mcp "$flow_mcp" "$@"
  fi
done

if command -v mdfind >/dev/null 2>&1; then
  flow_app=$(mdfind 'kMDItemCFBundleIdentifier == "com.flow.desktop"' | sed -n '1p')
  if [ -n "$flow_app" ]; then
    flow_mcp="$flow_app/Contents/Resources/bin/flow-mcp"
    if [ -x "$flow_mcp" ]; then
      run_mcp "$flow_mcp" "$@"
    fi
  fi
fi

fail "Flow MCP was not found. Install or update Flow, move Flow.app to Applications, and reopen Claude."
